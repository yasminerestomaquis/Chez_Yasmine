# Copier en .env (jamais committé) et renseigner les valeurs réelles.

# Supabase
SUPABASE_URL=https://tsebsulvhgttdwtgqfoj.supabase.co
SUPABASE_ANON_KEY=
# Lue uniquement par SupabaseAdminService (apps/api/nestjs/src/auth/) pour
# l'invitation d'utilisateurs (module Utilisateurs, 2026-09-09) — jamais pour
# l'upload/les URL signées de photos produit, qui utilisent toujours le jeton
# de l'utilisateur authentifié (voir ARCHITECTURE.md). Ne jamais exposer côté
# client — secret Supabase (Project Settings → API → service_role).
SUPABASE_SERVICE_ROLE_KEY=

# Base de données (connexion directe Postgres, pour Prisma côté NestJS)
DATABASE_URL=postgresql://postgres:password@db.tsebsulvhgttdwtgqfoj.supabase.co:5432/postgres

# NestJS
# Non lue par le code : décision actée en Phase 4, les JWT Supabase sont
# vérifiés via JWKS (clés publiques, `jose`), pas un secret partagé HS256 —
# voir ARCHITECTURE.md. Conservée pour référence face au prompt maître (§37).
JWT_SECRET=
API_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Storage
# Non lue par le code (le nom du bucket est une constante,
# `PRODUCT_IMAGES_BUCKET` dans src/storage/supabase-storage.service.ts) :
# le rendre configurable serait trompeur, puisque les policies RLS de
# `storage.objects` (Phase 5) sont écrites pour ce bucket précis — le
# changer ici sans recréer les mêmes policies casserait les uploads.
STORAGE_BUCKET=product-images
